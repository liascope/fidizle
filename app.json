{
  "expo": {
    "name": "fidizle",
    "slug": "fidizle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/appLogo.png",
    "scheme": "fidizle",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/appLogo.png",
      "bundleIdentifier": "com.liascope.fidizle",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/appLogo.png",
        "edgeToEdgeEnabled": false
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.liascope.fidizle",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/appLogo.png",
          "imageWidth": 76
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fda67eaf-43bf-4c6a-9117-59b1ab5f12a3"
      }
    }
  }
}
